{
  "type": "record",
  "name": "ScenarioRunCommand",
  "namespace": "io.chaosforge.schema.v1",
  "fields": [
    { "name": "scenarioId",     "type": "string" },
    { "name": "tenantId",       "type": "string" },
    { "name": "replayVersion",  "type": "long" },
    { "name": "ruleSetId",      "type": "string" },
    { "name": "ruleSetVersion", "type": "int" },
    { "name": "steps", "type": { "type": "array", "items": {
        "type": "record",
        "name": "Step",
        "namespace": "io.chaosforge.schema.v1",
        "fields": [
          { "name": "stepId",   "type": "string" },
          { "name": "stepType", "type": { "type": "enum", "name": "StepType", "symbols": ["LATENCY", "ERROR", "TIMEOUT"] } },
          { "name": "targetUrl", "type": "string" },
          { "name": "method",    "type": "string", "default": "GET" },
          { "name": "faultConfig", "type": { "type": "map", "values": "string" }, "default": {} }
        ]
    } }, "default": [] },
    { "name": "commandIssuedAt", "type": { "type": "long", "logicalType": "timestamp-millis" } }
  ]
}
