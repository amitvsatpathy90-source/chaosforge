# ChaosForge — canonical environment-variable manifest
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; this example file is the
# documented contract. Comments live on their own lines (never inline after a value) so the
# file is safe to copy verbatim regardless of which parser reads it.
#
# Two injection paths — know which one you need:
#
#   1. docker compose        — reads `.env` from this directory AUTOMATICALLY (interpolates
#                              ${VAR:-default} in docker-compose_chaosforge.yml).
#   2. Spring Boot services  — do NOT read .env. They read process environment. For bootRun:
#                                  set -a; source .env; set +a
#                                  ./gradlew :control-plane:bootRun
#                              In a real deployment, inject via the orchestrator's secret
#                              mechanism (K8s Secret envFrom, ECS task secrets, systemd
#                              EnvironmentFile, ...). Never bake values into application.yml.
#
# Posture (mtls-rules.md, ADR-0531):
#   [SECRET]    = sensitive; no safe default in prod. mTLS passwords deliberately have NO
#                 fallback anywhere — a missing value fails startup fast, never a silent downgrade.
#   [lab-dflt]  = has a localhost/Compose dev default baked into application.yml; the value here
#                 only needs setting when you deviate from the local lab topology.


# ─── Database (Control Plane + Execution Service + Compose postgres) ─────────────
# DB_PASSWORD is read by BOTH the services (application.yml) and Compose (POSTGRES_PASSWORD)
# so a single value keeps server and clients in agreement.

# [lab-dflt]
DB_USERNAME=chaosforge
# [SECRET] [lab-dflt]
DB_PASSWORD=chaosforge
# [lab-dflt]
CP_DB_URL=jdbc:postgresql://localhost:5432/chaosforge_cp
# [lab-dflt]
EXEC_DB_URL=jdbc:postgresql://localhost:5432/chaosforge_exec


# ─── Kafka / Redis topology ─────────────────────────────────────────────────────
# [lab-dflt] — read by both CP and Exec
KAFKA_BOOTSTRAP=localhost:9092
# [lab-dflt] — read by Gateway and CP
REDIS_HOST=localhost
# [lab-dflt]
REDIS_PORT=6379


# ─── Service mesh addresses ─────────────────────────────────────────────────────
# [lab-dflt] — read by Gateway and Exec.
# Under the `mtls` profile the CP serves HTTPS — use https://<host>:8081 there.
CONTROL_PLANE_URL=http://localhost:8081


# ─── JWT verification (all three services re-verify; ADR-0524) ──────────────────
# [lab-dflt] — served by the `jwks-stub` compose service. One-time setup:
#   docker/jwks/generate-jwks.sh            # key material (git-ignored output)
# then mint test tokens:
#   TENANT_JWT=$(docker/jwks/mint-jwt.sh --tenant <uuid>)
#   OPERATOR_JWT=$(docker/jwks/mint-jwt.sh --roles OPERATOR)
JWK_SET_URI=http://localhost:9000/.well-known/jwks.json
# Claim validation on top of signature+exp (mtls-rules.md: signature, exp, iss, aud). iss is an
# exact-string match, aud a contains-check; must equal what mint-jwt.sh stamps (its defaults match
# these). Point all three at your real IdP's values in any non-lab deployment.
JWT_ISSUER=http://localhost:9000
JWT_AUDIENCE=chaosforge


# ─── Deployment posture marker (ADR-0541; arch-audit F2) ───────────────────────
# The single switch that makes the security posture self-checking. `deployed` asserts, at startup,
# that this service's controls are ACTUALLY on — mTLS with client-auth=need, /internal CN scoping
# (CP), a client cert to the CP over https:// (exec + gateway), and a non-empty TARGET_ALLOWED_HOSTS.
# Any gap and the context refuses to refresh: the port never opens and the exception names each gap.
#
# SET THIS TO `deployed` IN EVERY NON-LAB ARTIFACT. It is not on by default because no test uses
# @ActiveProfiles (all run on the default profile), so a fail-closed default would fail the suite —
# which means a forgotten marker silently gets you lab posture. That residual is covered ONLY by the
# chaosforge.security.hardened gauge + the SecurityPostureNotHardened alert. Setting this is not
# optional in a real deployment; it is the thing that turns a silent insecure start into a loud one.
# [lab-dflt] lab | deployed
CHAOSFORGE_DEPLOYMENT=lab


# ─── mTLS profile (`--spring.profiles.active=mtls`; ADR-0531) ───────────────────
# Passwords are fail-fast: NO default exists in any application-mtls.yml. Keystore/truststore
# files are generated by docker/mtls/generate-certs.sh (git-ignored output; regenerate on demand).
#
# MTLS_KEYSTORE is PER-SERVICE. A single shared .env cannot hold three values for one variable —
# set MTLS_KEYSTORE in each service's own environment (e.g. its systemd EnvironmentFile / K8s
# container env), not here. Paths:
#   control-plane:     file:./docker/mtls/certs/control-plane-keystore.p12
#   execution-service: file:./docker/mtls/certs/execution-service-keystore.p12
#   edge-gateway:      file:./docker/mtls/certs/edge-gateway-keystore.p12

# [SECRET] fail-fast, no default
MTLS_KEYSTORE_PASSWORD=
# [SECRET] fail-fast, no default
MTLS_TRUSTSTORE_PASSWORD=
# per-service path — see note above; leave blank in a shared .env
MTLS_KEYSTORE=
# [lab-dflt] shared truststore (same for all three services)
MTLS_TRUSTSTORE=file:./docker/mtls/certs/truststore.p12
# [lab-dflt] CP /internal peer CNs (ADR-0532, per-path): rule-sets → exec cert CN,
# tenants/*/policy → gateway cert CN. Each must equal the CN in that service's client cert.
MTLS_INTERNAL_PEER_CN=execution-service
MTLS_INTERNAL_GATEWAY_CN=edge-gateway


# ─── Target blast-radius / SSRF guard (ADR-0534, target-validation-rules.md) ────
# Dev default is open (false / empty) so local targets work. The mtls profile flips
# block-private-networks to true; ALWAYS pin ALLOWED_HOSTS before running against real targets.

# [lab-dflt] — mtls profile default is true
TARGET_BLOCK_PRIVATE=false
# comma-separated exact hosts; empty = any public host
TARGET_ALLOWED_HOSTS=
# [lab-dflt] CP AI-authoring allowlist (empty = SSRF guard only)
AI_ALLOWED_TARGET_HOSTS=


# ─── AI authoring path (Control Plane only; ADR-0518/0521) ──────────────────────
# [lab-dflt]
OLLAMA_URL=http://localhost:11434
# [lab-dflt]
OLLAMA_MODEL=llama3.1:8b


# ─── Compose-only (docker-compose_chaosforge.yml) ───────────────────────────────
# [SECRET] [lab-dflt]
GRAFANA_ADMIN_PASSWORD=chaosforge


# ─── Operator / smoke-test convenience (Developer Commands) ────────────────────
# [SECRET] — a tenant-scoped bearer token minted by your IdP for curl smoke tests.
TENANT_JWT=
